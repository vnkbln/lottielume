+template<typename T>
+static LottieProperty* overrideEffectProperty(T* target, LottieProperty* prop, bool release)
+{
+    LottieProperty* backup = nullptr;
+    if (release) target->release();
+    else backup = new T(*target);
+    target->copy(*static_cast<T*>(prop), false);
+    return backup;
+}
+
+static LottieProperty* overrideEffectProperty(LottieProperty* target, LottieProperty* prop, bool release)
+{
+    if (target->type == LottieProperty::Type::Color)
+        return overrideEffectProperty(static_cast<LottieColor*>(target), prop, release);
+    if (target->type == LottieProperty::Type::Float)
+        return overrideEffectProperty(static_cast<LottieFloat*>(target), prop, release);
+    return nullptr;
+}
+
+
 void LottieSlot::reset()
 {
     if (!overridden) return;
 
     ARRAY_FOREACH(pair, pairs) {
-        pair->obj->override(pair->prop, true);
+        if (pair->direct) overrideEffectProperty(pair->direct, pair->prop, true);
+        else pair->obj->override(pair->prop, true);
         delete(pair->prop);
         pair->prop = nullptr;
     }
@@ -199,7 +220,8 @@ void LottieSlot::apply(LottieProperty* prop, bool byDefault)
 
     //apply slot object to all targets
     ARRAY_FOREACH(pair, pairs) {
-        auto backup = pair->obj->override(prop, release);
+        auto backup = pair->direct ? overrideEffectProperty(pair->direct, prop, release)
+                                   : pair->obj->override(prop, release);
         if (!release) pair->prop = backup;
     }
 
